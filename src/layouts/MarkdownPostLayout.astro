---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---

<html lang="es">
    <BaseLayout pageTitle={frontmatter.title}>
        <article class="post">
            <div class="post-cover">
                <img src={frontmatter.image.url} alt={frontmatter.image.alt} />
                <div class="post-cover-fade"></div>
            </div>

            <div class="post-meta">
                <span class="post-date">{frontmatter.pubDate.toString().slice(0,10)}</span>
                <span class="post-meta-dot">•</span>
                <span class="post-author">Por {frontmatter.author}</span>
            </div>

            <p class="post-description"><em>{frontmatter.description}</em></p>

            <div class="tags">
                {frontmatter.tags.map((tag: string) => (
                <p class="tag"><a href={`/tags/${tag}`}>{tag}</a></p>
                ))}
            </div>

            <div class="post-content">
                <slot />
            </div>
        </article>
    </BaseLayout>
    <style>
    .post-cover {
        position: relative;
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow-glow);
        margin-bottom: 1.25rem;
    }

    .post-cover img {
        width: 100%;
        max-height: 420px;
        object-fit: cover;
        object-position: top;
        display: block;
    }

    .post-cover-fade {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 55%, rgba(0, 0, 0, 0.55) 100%);
        pointer-events: none;
    }

    .post-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-muted);
        font-size: 0.9rem;
        font-weight: 600;
    }

    .post-date {
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .post-meta-dot {
        opacity: 0.5;
    }

    .post-description {
        font-size: 1.1rem;
        color: var(--text-muted);
        margin: 0.6rem 0 0;
    }
    </style>
</html>